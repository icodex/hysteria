#!/bin/sh

CONFIG_FILE="/etc/hysteria/server.yaml"

# 判断配置文件是否存在，如果不存在走不存在的逻辑
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Creating configuration file $CONFIG_FILE"
    mkdir -p /etc/hysteria
    cat <<EOF >"$CONFIG_FILE"
v2board:
  apiHost: ${apiHost}
  apiKey: ${apiKey}
  nodeID: ${nodeID}
acme:
  domains:
    - ${domain}
  email: ${email}
auth:
  type: v2board
trafficStats:
  listen: 127.0.0.1:7653
acl:
  inline:
    - reject(10.0.0.0/8)
    - reject(172.16.0.0/12)
    - reject(192.168.0.0/16)
    - reject(127.0.0.0/8)
    - reject(fc00::/7)
EOF
fi

# exec 让 hysteria 成为 PID 1，直接接收 docker stop 的信号优雅退出
exec hysteria server -c "$CONFIG_FILE"
